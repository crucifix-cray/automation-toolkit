# Railway live sessions: tokens stay LOCAL, index stays TRACKED.
# Tracked per session: email.txt, created_at.txt (no secrets).
# Ignored per session: everything auth (CLI config, cookies, caches).
sessions/*/.railway/
sessions/*/browser_cookies.json
sessions/*/railway_cli_config.json
sessions/*/railway_cli_sessions/
sessions/*/config.json
sessions/*/.cache/
sessions/*/.local/
sessions/*/.config/
sessions/*/.ssh/
sessions/*/.venv/
sessions/*/node_modules/
# Template leftovers (deploy experiments copied into early sessions)
sessions/*/script1-deploy/
sessions/*/script1-ubuntu/
sessions/*/test-deploy/
sessions/*/warp-*/
sessions/*/FREE-TIER-FARM-STRATEGY.md
sessions/*/REAL-RESIDENTIAL-PROXY-SOLUTION.md
sessions/*/check-lovable-api.sh

# Local helper dirs (contain live tokens/project links, never commit)
credit_accounts/
gabrielgreen14/

# Global auth/secret patterns (any depth)
.railway/
browser_cookies.json
railway_cli_config.json
*.session
rclone.conf
*TOKEN*.json
*token*.json

# Python / caches
__pycache__/
*.pyc
.pytest_cache/
*.log

# Browser profiles (1.7GB junk, never commit)
browser_profile_*/
railway_profile/

# Project configs with secrets
chimera-bridge/config.json
chimera-bridge/config-test.json
chimera-bridge/.git/

# OpenCode session backups contain credentials (GH PAT, ProtonVPN, Mega) - never commit.
opencode backups/opencode.db
opencode backups/opencode.db-shm
opencode backups/opencode.db-wal
opencode backups/sessions/

# OnKernel sessions contain API keys + Clerk cookies (onk-api.py / onk-org-reset.py) - never commit.
finals/sessions/onk_*.json
finals/sessions/latest_onk.json
